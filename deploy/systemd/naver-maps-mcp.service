[Unit]
Description=Naver Maps MCP Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/naver-maps-mcp/gateway.env
Environment=GATEWAY_HOST=127.0.0.1
Environment=GATEWAY_PORT=3000
Environment=GATEWAY_JAVA_BASE_URL=http://127.0.0.1:8080
Environment=GATEWAY_JAVA_BIN=java
Environment=GATEWAY_JAVA_JAR=%h/.local/share/naver-maps-mcp/naver-maps-mcp.jar
Environment=GATEWAY_JAVA_HEADLESS=true
Environment=GATEWAY_JAVA_IDLE_TIMEOUT=5m
Environment=GATEWAY_JAVA_STARTUP_TIMEOUT=90s
Environment=GATEWAY_JAVA_SHUTDOWN_TIMEOUT=15s
Environment=GATEWAY_SERVICE_NAME=naver-maps-mcp
Environment=GATEWAY_SHUTDOWN_TIMEOUT=5s
ExecStart=%h/.local/libexec/naver-maps-mcp/naver-maps-mcp
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
